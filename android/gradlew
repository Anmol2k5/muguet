#!/bin/sh
# Gradle wrapper stub. Requires gradle-wrapper.jar next to this script
# (fetched by scripts/fetch-gradle-wrapper.sh once approved; pinned Gradle 8.10.2).
APP_BASE_NAME=${0##*/}
APP_HOME=$(cd "${APP_BASE_NAME%/*}" >/dev/null && pwd -P)
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
exec java -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
